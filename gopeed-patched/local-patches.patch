+		handler := ieproxy.GetProxyFunc()
+		if handler == nil {
+			return nil, nil
+		}
+		return handler(&http.Request{URL: &url.URL{Scheme: "http", Host: "example.com"}})
+	}
+	if cfg.Scheme == "" || cfg.Host == "" {
+		return nil, nil
+	}
+	return util.BuildProxyUrl(cfg.Scheme, cfg.Host, cfg.Usr, cfg.Pwd), nil
+}
