+// applyRename renames the finished download result to the name the caller asked
+// for in Options.Rename and then forgets the request.
+func (d *Downloader) applyRename(task *Task) {
+	if task.Meta == nil || task.Meta.Opts == nil {
+		return
+	}
+	want := strings.TrimSpace(task.Meta.Opts.Rename)
+	if want == "" {
+		return
+	}
+	task.Meta.Opts.Rename = ""
+	if err := d.renameResult(task, want); err != nil {
+		d.Logger.Warn().Err(err).Msgf("rename download result failed, task id: %s", task.ID)
+	} else {
+		// The data was renamed, so seeding it any more would make the torrent
+		// client recreate the old files (as .part) next to the new name. Mark
+		// the task as not uploading so a restart does not resume upload either.
+		task.Uploading = false
+	}
+	d.saveTask(task)
+}
+
+// renameResult performs the in-place rename of a finished task.
+//
+// The result stays in the same directory, an existing target is never
+// overwritten, and a single file keeps its original extension when the new name
+// carries none. On success Opts.Name is updated to the new base name, so the
+// panel displays it and doDelete(force) removes the renamed result.
+func (d *Downloader) renameResult(task *Task, want string) error {
+	if task.Meta.Res == nil || len(task.Meta.Res.Files) == 0 {
+		return errors.New("任务没有可用的下载结果")
+	}
+	name, err := cleanRenameName(want)
+	if err != nil {
+		return err
+	}
+
+	// A resource with a name is a torrent folder, everything else is one file.
+	multi := task.Meta.Res.Name != ""
+	old := task.Meta.SingleFilepath()
+	if multi {
+		old = task.Meta.FolderPath()
+	}
+	if !multi {
+		if ext := path.Ext(old); ext != "" && path.Ext(name) == "" {
+			name += ext
+		}
+	}
+	if _, statErr := os.Stat(old); statErr != nil {
+		return fmt.Errorf("找不到下载结果 %s: %w", old, statErr)
+	}
+
+	dst := path.Join(path.Dir(old), name)
+	if dst != old {
+		if _, statErr := os.Stat(dst); statErr == nil {
+			return fmt.Errorf("目标 %s 已存在，没有覆盖", dst)
+		} else if !errors.Is(statErr, os.ErrNotExist) {
+			return statErr
+		}
+		// A seeding BT task would recreate the old data next to the renamed one,
+		// so detach it from the torrent client before touching the filesystem.
+		if detacher, ok := task.fetcher.(interface{ DetachForRename() }); ok {
+			detacher.DetachForRename()
+		}
+		if err := os.Rename(old, dst); err != nil {
+			return err
+		}
+	}
+
+	task.Meta.Opts.Name = name
+	if multi {
+		task.Meta.Res.Name = name
+	} else {
+		task.Meta.Res.Files[0].Name = name
+	}
+	return nil
+}
+
+// cleanRenameName validates and sanitizes a caller supplied rename value.
+func cleanRenameName(want string) (string, error) {
+	name := strings.TrimSpace(want)
+	if name == "" {
+		return "", errors.New("重命名不能为空")
+	}
+	if name == "." || name == ".." {
+		return "", errors.New("重命名不合法")
+	}
+	if strings.ContainsAny(name, `/\`) {
+		return "", errors.New("重命名只能是文件名，不能带目录分隔符")
+	}
+	name = util.SafeFilename(name)
+	if name == "" || name == "." || name == ".." {
+		return "", errors.New("重命名不合法")
+	}
+	return name, nil
+}
+
